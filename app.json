{
  "expo": {
    "name": "CoachFit",
    "slug": "coachfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/coachfit-icon-fluid-strength.png",
    "scheme": "coachfit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aterminassian.coachfit",
      "buildNumber": "18",
      "appleTeamId": "74RR9W783P"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12131C",
        "foregroundImage": "./assets/images/coachfit-icon-fluid-strength-foreground.png",
        "monochromeImage": "./assets/images/coachfit-icon-fluid-strength-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/coachfit-icon-fluid-strength.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171922"
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.aterminassian.coachfit",
          "widgets": []
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "CoachFit saves your completed workouts to Health so they show up alongside your other activity.",
          "NSHealthUpdateUsageDescription": "CoachFit saves your completed workouts to Health so they show up alongside your other activity.",
          "background": false
        }
      ],
      "./plugins/withLiveActivityTermination.js",
    "./plugins/withDsymFix.js",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/coachfit-icon-fluid-strength-notification.png",
          "color": "#8DBFA0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
